# --- Garage app configuration ---

# Secret key for signing session cookies. REQUIRED — the app refuses to start
# with the default/empty value (unless DEBUG=true). Generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to true ONLY for local development: relaxes the HTTPS-only cookie and the
# SECRET_KEY safety check. Never enable in production.
DEBUG=false

# Anthropic API key for scanned-receipt parsing (Claude Vision).
# Leave empty to disable OCR and use manual entry only.
ANTHROPIC_API_KEY=
# Vision model used to parse receipts
VISION_MODEL=claude-opus-4-8

# SQLite database location (inside the container / volume)
DATABASE_URL=sqlite:////data/garage.db

# Where uploaded receipt scans are stored
RECEIPTS_DIR=/data/receipts

# --- Email alert summaries (SMTP) ---
# Leave SMTP_HOST empty to disable email sending (alerts still show in-app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=garage@example.com
ALERT_EMAIL_TO=liav@nefesh.co.il

# --- Initial users (created on first startup) ---
# Format: name:email:password , comma-separated for multiple users.
# Use STRONG, unique passwords here (not the placeholder). You can rotate them
# later from the in-app "חשבון" (/account) screen.
INITIAL_USERS=Liav:liav@nefesh.co.il:CHANGE-ME-strong-pass,Wife:wife@example.com:CHANGE-ME-strong-pass
