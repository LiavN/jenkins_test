# --- Garage app configuration ---

# Secret key for signing session cookies (change this!)
SECRET_KEY=change-me-to-a-long-random-string

# Anthropic API key for scanned-receipt parsing (Claude Vision).
# Leave empty to disable OCR and use manual entry only.
ANTHROPIC_API_KEY=
# Vision model used to parse receipts
VISION_MODEL=claude-opus-4-8

# SQLite database location (inside the container / volume)
DATABASE_URL=sqlite:////data/garage.db

# Where uploaded receipt scans are stored
RECEIPTS_DIR=/data/receipts

# --- Email alert summaries (SMTP) ---
# Leave SMTP_HOST empty to disable email sending (alerts still show in-app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=garage@example.com
ALERT_EMAIL_TO=liav@nefesh.co.il

# --- Initial users (created on first startup) ---
# Format: name:email:password , comma-separated for multiple users.
INITIAL_USERS=Liav:liav@nefesh.co.il:changeme,Wife:wife@example.com:changeme
