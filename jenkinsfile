pipeline {
    agent any
    stages {
        stage('Install deps') {
            steps {
                sh 'python3 -m pip install --user -r requirements.txt'
            }
        }
        stage('Run tests') {
            steps {
                sh 'python3 -m pytest -q > output.txt 2>&1'
            }
        }
        stage('Dependency audit') {
            steps {
                // Scan dependencies for known CVEs. Non-fatal: reports advisories
                // without blocking the build.
                sh 'python3 -m pip install --user pip-audit || true'
                sh 'python3 -m pip_audit -r requirements.txt >> output.txt 2>&1 || true'
            }
        }
        stage('Build image') {
            steps {
                sh 'docker build -t garage:latest .'
            }
        }
    }
    post {
        always {
            script {
                def consoleReport = readFile('output.txt')
                def emailBody = 'Hello,\n\nGarage CI test report:\n\n' + consoleReport
                emailext body: emailBody,
                         subject: "Garage CI — ${currentBuild.currentResult}",
                         to: 'liav@nefesh.co.il'
            }
        }
    }
}
